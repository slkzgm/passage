{
  "name": "passage",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Sponsored asset transfers across Fomo EVM networks",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:fork": "tsx scripts/test-fork.ts",
    "test:rpc": "tsx scripts/check-public-rpcs.ts",
    "test:e2e": "tsx scripts/test-fork.ts --browser",
    "check": "tsc --noEmit && vitest run"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "dependencies": {
    "@reown/appkit": "^1.8.24",
    "@tanstack/react-query": "^5.104.0",
    "@wagmi/core": "2.22.1",
    "@walletconnect/sign-client": "2.23.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
